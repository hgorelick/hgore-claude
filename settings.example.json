{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-banned-bash.sh"
          }
        ]
      },
      {
        "matcher": "ScheduleWakeup|CronCreate|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-self-scheduling.sh"
          }
        ]
      }
    ]
  }
}
